FROM node:22-slim

WORKDIR /app

COPY bridge/package.json bridge/package-lock.json ./
RUN npm ci --omit=dev

COPY bridge/ ./

# Place skills where pi auto-discovers them (.pi/skills/)
RUN mkdir -p .pi/skills && \
    cp -r skills/ .pi/skills/

ENV BRIDGE_PORT=3001
EXPOSE 3001

CMD ["node", "server.mjs"]
