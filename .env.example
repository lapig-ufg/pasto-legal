# ── App environment ─────────────────────────────────────────────────────
APP_ENV="development"  # development | stagging | production

# ── pi Bridge ───────────────────────────────────────────────────────────
BRIDGE_URL="http://localhost:3001"

# ── Database ────────────────────────────────────────────────────────────
DATABASE_TYPE="sqlite"  # sqlite | postgres

POSTGRES_HOST=""
POSTGRES_PORT=5432
POSTGRES_DBNAME=""
POSTGRES_USER=""
POSTGRES_PASSWORD=""

# ── WhatsApp ────────────────────────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_WEBHOOK_URL=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_APP_SECRET=""

# ── Valkey/Redis (debouncing + session state) ───────────────────────────
VALKEY_HOST="localhost"
VALKEY_PORT=6379
VALKEY_DB=0

# ── /chat endpoint (used by the WhatsApp router to call the agent) ───────
CHAT_URL="http://localhost:3000"

# ── Google Earth Engine ─────────────────────────────────────────────────
GEE_PROJECT="your-project-id"
GEE_SERVICE_ACCOUNT="your-service-account@iam.gserviceaccount.com"
GEE_KEY_FILE="path/to/key.json"

# ── LLM (used by pi bridge) ─────────────────────────────────────────────
GOOGLE_API_KEY=""

# ── pi session bridge ───────────────────────────────────────────────────
# Per-user pi subprocess settings (see agent/pi_rpc.py).
# PI_PROVIDER="google"
# PI_MODEL="gemini-3.5-flash-lite"
# PI_SESSION_TTL="1800"
# PI_SESSIONS_DIR="/tmp/pi-sessions"
# Set to "1" to dump the full prompt sent to the LLM (system prompt + history
# + current build_prompt() text) to <PI_SESSIONS_DIR>/<user_id>/last_prompt.{json,md}
# after every run. Useful for debugging. Off by default.
PI_DUMP_PROMPT=""

# ── Speech-to-text (audio transcription) ─────────────────────────────────
# Gemini model used to transcribe incoming audio messages. Defaults to
# gemini-flash-latest if unset.
STT_MODEL="gemini-flash-latest"

# ── S3 (required in production/stagging; ignored in development) ────────
S3_ENDPOINT_URL=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET="pasto-legal"
S3_REGION=""
