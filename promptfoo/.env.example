# URL of the running Pasto Legal FastAPI app (api/main.py).
# The chat provider POSTs to ${CHAT_URL}/chat and resets via ${CHAT_URL}/reset.
CHAT_URL="http://localhost:3000"

# Google API key — the agent (pi subprocess) uses Gemini.
# Only needed when running against a real app instance that spawns pi.
# The promptfoo process itself does not call Gemini directly unless you
# enable the LLM-as-judge grader (see run.mjs → JUDGE_MODEL).
GOOGLE_API_KEY=""

# Judge model used by the optional LLM-as-judge assertion.
# Set to empty to disable the judge (deterministic assertions only).
JUDGE_MODEL="google:gemini-2.5-flash"

# Prefix for per-test ephemeral user IDs. Each test gets a unique user_id
# so the pi RPC pool isolates sessions.
TEST_USER_ID_PREFIX="promptfoo"

# Set to 1 to include cases that exercise real Earth Engine tool calls
# (slow, require GEE credentials and registered properties).
RUN_GEE_TESTS=0

# Max concurrency for promptfoo. The pi RPC pool is per-user, but
# serializing avoids load surprises during evals.
MAX_CONCURRENCY=1