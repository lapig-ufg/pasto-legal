# Heavy, slow-changing layer: OS packages, uv, Python dependencies, DuckDB spatial.
# Build and publish manually when pyproject.toml / uv.lock change:  make base-push
FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

RUN apt-get update && apt-get install -y --no-install-recommends \
        ffmpeg libpq-dev gcc git curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

ENV PATH="/app/.venv/bin:$PATH"

# uv.lock pins semente-agents to the lapig-ufg/semente main branch: uv sync
# fetches it from the repository. git (above) is required for that fetch.
COPY pyproject.toml uv.lock ./

RUN uv sync --frozen --no-cache --no-install-project

RUN .venv/bin/python -c "import duckdb; duckdb.connect().execute('INSTALL spatial;')"
